کار مجموع(لیست_ورودی):
    جمع = 0
    برای هر x توی لیست_ورودی:
        جمع += x
    بده جمع

کار میانگین(لیست_ورودی):
    بده مجموع(لیست_ورودی) / طول(لیست_ورودی)

کار حداکثر(لیست_ورودی):
    بیشتر = لیست_ورودی[0]
    برای هر x توی لیست_ورودی:
        اگه x > بیشتر:
            بیشتر = x
    بده بیشتر
