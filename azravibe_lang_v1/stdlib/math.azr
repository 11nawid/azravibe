کار prod(items):
    out = 1
    برای هر item توی items:
        out = out * item
    بده out

کار dist(a، b):
    total = 0
    برای هر i توی محدوده(طول(a)):
        d = a[i] - b[i]
        total = total + d * d
    بده sqrt(total)
