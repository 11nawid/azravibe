کار توان(پایه، توان):
    بده پایه ** توان

کار جذر(x):
    بده x ** 0.5

کار فاکتوریل(n):
    اگه n == 0:
        بده 1
    وگرنه:
        بده n * فاکتوریل(n - 1)

کار اول_هست(n):
    اگه n < 2:
        بده غلطه
    برای هر i توی محدوده(2، عدد_صحیح(جذر(n)) + 1):
        اگه n % i == 0:
            بده غلطه
    بده درسته

پی = 3.14159265358979
ای = 2.71828182845904
